---
const {
  title = 'Sai Sreenivas Chintha | ML Research Engineer',
  description = 'Personal website and portfolio for Sai Sreenivas Chintha, an ML research engineer focused on NLP, information retrieval, vision-language models, and responsible AI.'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #141617;
    --panel: #1a1d1f;
    --text: #f4f7fb;
    --muted: #c1c8cf;
    --soft: #2a2f33;
    --accent: #29c4ef;
    --accent-dark: #14a5cf;
    --chip: #192e36;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: "Avenir Next", Avenir, Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
  }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--accent); }
  main { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
  .section { margin: 56px 0; }
  .section-header { margin-bottom: 24px; }
  .eyebrow { color: var(--accent); font-weight: 700; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.12em; }
  h1, h2, h3 { line-height: 1.1; margin: 0; }
  h1 { font-size: clamp(2.6rem, 6vw, 4.8rem); letter-spacing: -0.04em; }
  h2 { font-size: clamp(1.8rem, 3vw, 2.3rem); letter-spacing: -0.03em; }
  h3 { font-size: 1.08rem; }
  p { color: var(--muted); margin: 0; }
  .grid { display: grid; gap: 18px; }
  .card {
    background: color-mix(in srgb, var(--panel) 92%, transparent);
    border: 1px solid var(--soft);
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 12px 36px rgb(2 6 9 / 0.25);
  }
  .pill-list { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .pill { background: var(--chip); color: #a7def1; border: 1px solid #23576a; padding: 6px 10px; border-radius: 999px; font-size: 0.9rem; font-weight: 600; }
  .button-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .button { display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; padding: 10px 16px; font-weight: 700; border: 1px solid #5a626a; }
  .button.primary { background: #f4f7fb; color: #111827; border-color: #f4f7fb; }
  .button.secondary { background: transparent; color: var(--text); }
  .button:hover { transform: translateY(-1px); color: inherit; }
  .timeline { display: grid; gap: 16px; }
  .item { display: grid; grid-template-columns: 1fr auto; gap: 12px; border-top: 1px solid var(--soft); padding-top: 18px; }
  .item:first-child { border-top: 0; padding-top: 0; }
  .meta { color: var(--muted); font-size: 0.92rem; white-space: nowrap; }
  ul { margin: 12px 0 0; padding-left: 20px; color: var(--muted); }
  li + li { margin-top: 6px; }
  @media (max-width: 760px) {
    .item { grid-template-columns: 1fr; }
    .meta { white-space: normal; }
  }
</style>
