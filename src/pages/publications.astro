---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { publications } from '../data/content';
---

<BaseLayout title="Publications | Sai Sreenivas Chintha">
  <Header />
  <main>
    <section class="section publications-page">
      <header class="pub-page-header">
        <h1>publications</h1>
        <p class="pub-subtitle">publications in reversed chronological order.</p>
      </header>

      <div class="pub-entries">
        {publications.map((pub) => (
          <article class="pub-entry">
            <div class="pub-content">
              <h2 class="pub-title">{pub.title}</h2>
              <p class="pub-authors">{pub.authors}</p>
              <p class="pub-venue"><em>{pub.venue}</em></p>
              <a class="pub-abs" href={pub.link} target="_blank" rel="noopener noreferrer">ABS</a>
            </div>
            <div class="pub-year" aria-hidden="true">{pub.year}</div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .publications-page {
    margin-top: 12px;
  }
  .pub-page-header {
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--soft);
  }
  .pub-page-header h1 {
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 600;
    text-transform: lowercase;
    letter-spacing: -0.02em;
    color: #1e293b;
  }
  .pub-subtitle {
    margin-top: 8px;
    font-size: 0.92rem;
    font-weight: 400;
    color: #64748b;
  }
  .pub-entries {
    display: grid;
    gap: 0;
  }
  .pub-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: start;
    padding: 22px 0;
    border-bottom: 1px solid var(--soft);
  }
  .pub-entry:first-child {
    padding-top: 0;
  }
  .pub-content {
    display: grid;
    gap: 6px;
  }
  .pub-title {
    font-size: 1.06rem;
    font-weight: 500;
    line-height: 1.45;
    color: #334155;
    letter-spacing: 0.01em;
  }
  .pub-authors {
    font-size: 0.95rem;
    font-weight: 400;
    color: #64748b;
    line-height: 1.55;
  }
  .pub-venue {
    font-size: 0.94rem;
    font-weight: 400;
    color: #64748b;
    margin: 0;
  }
  .pub-venue em {
    font-style: italic;
    font-weight: 400;
  }
  .pub-abs {
    display: inline-flex;
    width: fit-content;
    margin-top: 8px;
    padding: 3px 10px;
    border: 1px solid #cbd5e1;
    border-radius: 3px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: #475569;
    background: #f8fafc;
  }
  .pub-abs:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
    color: #0ea5e9;
  }
  .pub-year {
    font-size: clamp(2.2rem, 4.5vw, 3rem);
    font-weight: 500;
    line-height: 1;
    color: #e2e8f0;
    letter-spacing: -0.03em;
    user-select: none;
  }
  @media (max-width: 720px) {
    .pub-entry {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .pub-year {
      font-size: 1.6rem;
    }
  }
</style>
