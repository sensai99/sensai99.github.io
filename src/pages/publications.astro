---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { publications } from '../data/content';
---

<BaseLayout title="Publications | Sai Sreenivas Chintha">
  <Header />
  <main>
    <section class="section publications-page">
      <header class="pub-page-header">
        <h1>publications</h1>
        <p class="pub-subtitle">publications in reversed chronological order.</p>
      </header>

      <div class="pub-entries">
        {publications.map((pub) => (
          <article class="pub-entry">
            <div class="pub-content">
              <h2 class="pub-title">{pub.title}</h2>
              <p class="pub-authors">{pub.authors}</p>
              <p class="pub-venue"><em>{pub.venue}</em></p>
              <a class="pub-abs" href={pub.link} target="_blank" rel="noopener noreferrer">ABS</a>
            </div>
            <div class="pub-year" aria-hidden="true">{pub.year}</div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .publications-page {
    margin-top: 12px;
  }
  .pub-page-header {
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--soft);
  }
  .pub-page-header h1 {
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 800;
    text-transform: lowercase;
    letter-spacing: -0.03em;
  }
  .pub-subtitle {
    margin-top: 8px;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .pub-entries {
    display: grid;
    gap: 0;
  }
  .pub-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: start;
    padding: 22px 0;
    border-bottom: 1px solid var(--soft);
  }
  .pub-entry:first-child {
    padding-top: 0;
  }
  .pub-content {
    display: grid;
    gap: 6px;
  }
  .pub-title {
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.35;
    color: var(--text);
  }
  .pub-authors {
    font-size: 0.98rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .pub-venue {
    font-size: 0.98rem;
    color: var(--muted);
    margin: 0;
  }
  .pub-abs {
    display: inline-flex;
    width: fit-content;
    margin-top: 6px;
    padding: 2px 10px;
    border: 1px solid var(--text);
    border-radius: 2px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text);
  }
  .pub-abs:hover {
    background: var(--text);
    color: #fff;
  }
  .pub-year {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 700;
    line-height: 1;
    color: #cbd5e1;
    letter-spacing: -0.04em;
    user-select: none;
  }
  @media (max-width: 720px) {
    .pub-entry {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .pub-year {
      font-size: 1.6rem;
    }
  }
</style>
