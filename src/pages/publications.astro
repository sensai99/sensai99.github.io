---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { publications } from '../data/content';
---

<BaseLayout title="Publications | Sai Sreenivas Chintha">
  <Header />
  <main>
    <section class="section">
      <div class="section-header">
        <h2>PUBLICATIONS</h2>
      </div>
      <ul class="pub-list">
        {publications.map((pub) => (
          <li>
            <a class="pub-title" href={pub.link} target="_blank" rel="noopener noreferrer">
              {pub.title}
            </a>
            <span class="pub-venue"> {pub.venue}.</span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .pub-list {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.75;
  }
  .pub-list li + li {
    margin-top: 14px;
  }
  .pub-title {
    color: #0369a1;
    font-weight: 700;
    font-style: italic;
  }
  .pub-title:hover {
    color: var(--accent);
  }
  .pub-venue {
    color: var(--text);
    font-style: normal;
    font-weight: 400;
  }
</style>
