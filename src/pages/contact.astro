---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Contact | Sai Sreenivas Chintha">
  <Header />
  <main>
    <section class="section contact">
      <div class="card">
        <h2>CONTACT</h2>
        <p>Best fit: applied/research roles in NLP, retrieval, multimodal learning, efficient LLM inference, and responsible AI.</p>
        <div class="button-row">
          <a class="button primary" href="mailto:chinthasaisreenivas@gmail.com">Email</a>
          <a class="button secondary" href="tel:+14134724423">Call</a>
          <a class="button secondary" href="https://github.com/sensai99" target="_blank">GitHub</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact .card {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }
  .contact .button-row { justify-content: center; }
</style>
