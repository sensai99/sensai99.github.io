---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { profile } from '../data/content';
import meImage from '../layouts/temp/images/me.jpeg';

const sectionLinks = [
  { href: '/research', title: 'Research', copy: 'Publications, labs, and current research directions.' },
  { href: '/projects', title: 'Projects', copy: 'Hands-on work with measurable outcomes and impact.' },
  { href: '/publications', title: 'Publications', copy: 'Papers, preprints, and technical writing.' },
  { href: '/experience', title: 'Experience', copy: 'Industry and research engineering experience.' },
  { href: '/contact', title: 'Contact', copy: 'Best ways to reach me for opportunities.' }
];
---

<BaseLayout>
  <Header />
  <main>
    <section class="hero section">
      <div class="hero-copy">
        <h1 class="name-title">{profile.name}</h1>
        <p class="affiliations"><span class="eyebrow">Affiliations</span> {profile.affiliations}</p>
        <img
          class="profile-photo"
          src={meImage.src}
          alt="Sai Sreenivas Chintha"
          width={meImage.width}
          height={meImage.height}
        />
        {profile.bio.map((paragraph) => (
          <p class="hero-text" set:html={paragraph} />
        ))}
        <div class="button-row hero-buttons">
          <a class="button secondary" href="mailto:chinthasaisreenivas@gmail.com">
            <SocialIcon name="email" />
            Email
          </a>
          <a class="button secondary" href="https://linkedin.com/in/sai-sreenivas" target="_blank" rel="noopener noreferrer">
            <SocialIcon name="linkedin" />
            LinkedIn
          </a>
          <a class="button secondary" href="https://github.com/sensai99" target="_blank" rel="noopener noreferrer">
            <SocialIcon name="github" />
            GitHub
          </a>
        </div>
      </div>
    </section>
    <section class="section">
      <div class="section-header">
        <h2>SECTIONS</h2>
      </div>
      <div class="section-grid">
        {sectionLinks.map((section) => (
          <a class="card section-card" href={section.href}>
            <h3>{section.title}</h3>
            <p>{section.copy}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    margin-top: 20px;
  }
  .hero-copy::after {
    content: '';
    display: block;
    clear: both;
  }
  .affiliations {
    color: var(--muted);
    margin-top: 10px;
    margin-bottom: 12px;
    font-size: 1.06rem;
  }
  .hero-text {
    font-size: 1.28rem;
    margin-top: 18px;
    color: #334155;
  }
  .hero-text :global(a) {
    color: #0369a1;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .hero-text :global(a:hover) {
    color: var(--accent);
  }
  .name-title {
    white-space: nowrap;
    font-size: clamp(2rem, 5.2vw, 4.8rem);
  }
  .profile-photo {
    float: right;
    width: clamp(220px, 30vw, 320px);
    aspect-ratio: 1 / 1;
    height: auto;
    object-fit: cover;
    object-position: center 72%;
    border-radius: 10px;
    margin: 4px 0 20px 28px;
  }
  .hero-buttons {
    clear: both;
    padding-top: 4px;
  }
  .section-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .section-card p { margin-top: 10px; }
  .section-card:hover { border-color: #93c5fd; }
  @media (max-width: 860px) {
    .section-grid { grid-template-columns: 1fr; }
    .profile-photo {
      float: none;
      display: block;
      width: min(100%, 300px);
      margin: 0 auto 24px;
    }
    .name-title {
      white-space: normal;
    }
  }
</style>
