---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { profile } from '../data/content';
import meImage from '../layouts/temp/images/me.jpeg';

const sectionLinks = [
  { href: '/research', title: 'Research', copy: 'Publications, labs, and current research directions.' },
  { href: '/projects', title: 'Projects', copy: 'Hands-on work with measurable outcomes and impact.' },
  { href: '/publications', title: 'Publications', copy: 'Papers, preprints, and technical writing.' },
  { href: '/experience', title: 'Experience', copy: 'Industry and research engineering experience.' },
  { href: '/contact', title: 'Contact', copy: 'Best ways to reach me for opportunities.' }
];
---

<BaseLayout>
  <Header />
  <main>
    <section class="hero section">
      <div class="hero-copy">
        <h1 class="name-title">{profile.name}</h1>
        <p class="affiliations"><span class="eyebrow">Affiliations</span> {profile.affiliations}</p>
        <p class="hero-text">{profile.bio[0]}</p>
        <p class="hero-text">{profile.bio[1]}</p>
        <div class="button-row">
          <a class="button secondary" href="mailto:chinthasaisreenivas@gmail.com">
            <SocialIcon name="email" />
            Email
          </a>
          <a class="button secondary" href="https://linkedin.com/in/sai-sreenivas" target="_blank" rel="noopener noreferrer">
            <SocialIcon name="linkedin" />
            LinkedIn
          </a>
          <a class="button secondary" href="https://github.com/sensai99" target="_blank" rel="noopener noreferrer">
            <SocialIcon name="github" />
            GitHub
          </a>
        </div>
      </div>
      <aside class="hero-card">
        <img class="profile-photo" src={meImage.src} alt="Sai Sreenivas Chintha" />
      </aside>
    </section>
    <section class="section">
      <div class="section-header">
        <h2>SECTIONS</h2>
      </div>
      <div class="section-grid">
        {sectionLinks.map((section) => (
          <a class="card section-card" href={section.href}>
            <h3>{section.title}</h3>
            <p>{section.copy}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(300px, 0.7fr);
    gap: 30px;
    align-items: start;
    margin-top: 20px;
  }
  .affiliations {
    color: var(--muted);
    margin-top: 10px;
    margin-bottom: 4px;
    font-size: 1.06rem;
  }
  .hero-text {
    font-size: 1.28rem;
    max-width: 760px;
    margin-top: 18px;
    color: #334155;
  }
  .name-title {
    white-space: nowrap;
    font-size: clamp(2rem, 5.2vw, 4.8rem);
  }
  .hero-card {
    align-self: stretch;
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
  }
  .profile-photo {
    width: 100%;
    min-height: 360px;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    border-radius: 10px;
    display: block;
  }
  .section-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .section-card p { margin-top: 10px; }
  .section-card:hover { border-color: #93c5fd; }
  @media (max-width: 860px) {
    .hero, .section-grid { grid-template-columns: 1fr; }
  }
</style>
