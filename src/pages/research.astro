---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { research } from '../data/content';
import microsoftLogo from '../layouts/temp/images/logos/microsoft.svg';
import umassLogo from '../layouts/temp/images/logos/umass-seal.png';
import klaLogo from '../layouts/temp/images/logos/kla.svg';

const logos = {
  microsoft: microsoftLogo,
  umass: umassLogo,
  kla: klaLogo
} as const;
---

<BaseLayout title="Research | Sai Sreenivas Chintha">
  <Header />
  <main>
    <section class="section">
      <div class="section-header">
        <h2>RESEARCH</h2>
      </div>
      <div class="card timeline">
        {research.map((item) => (
          <article class="item">
            <div>
              <div class="role-row">
                <img
                  class:list={[
                    'org-logo-img',
                    item.logo === 'umass' && 'org-logo-img--seal',
                    item.logo === 'kla' && 'org-logo-img--wide'
                  ]}
                  src={logos[item.logo as keyof typeof logos].src}
                  alt={`${item.org} logo`}
                />
                <h3>{item.role} · {item.org}</h3>
              </div>
              <ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
            </div>
            <span class="meta">{item.date}</span>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .timeline { display: grid; gap: 16px; }
  .role-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .org-logo-img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .org-logo-img--seal {
    width: 56px;
    height: 56px;
  }
  .org-logo-img--wide {
    width: auto;
    min-width: 88px;
    max-width: 110px;
    height: 44px;
  }
</style>
